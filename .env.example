# ===== 테스트용 Postgres (docker-compose 내부) =====
POSTGRES_DB=mero
POSTGRES_USER=mero
POSTGRES_PASSWORD=mero

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY=3600000
JWT_REFRESH_TOKEN_VALIDITY=86400000

# ===== Supabase Storage (테스트용 버킷 권장, 운영 키 사용 금지) =====
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_IMAGES=
STORAGE_BUCKET_DOCS=

# ===== Mail (Resend) =====
RESEND_USERNAME=
RESEND_API_KEY=
MAIL_FROM_ADDRESS=

# ===== OAuth =====
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/auth/naver/callback
APPLE_BUNDLE_ID=
GOOGLE_CLIENT_IDS=

# ===== App =====
APP_BASE_URL=http://localhost:8080
